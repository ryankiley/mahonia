{
  "name": "mahonia",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A no-login ultralight gear-list / pack-weight tracker — a better LighterPack.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "dev:preview": "nuxt dev --host ::1",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/setup-git-hooks.mjs",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.mjs",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "changelog": "jiti scripts/changelog.ts",
    "changelog:compact": "jiti scripts/compact-changelog.ts",
    "release-notes": "jiti scripts/release-notes.ts",
    "og:site": "jiti scripts/render-og-site.ts",
    "catalog:build": "jiti scripts/build-catalog.ts",
    "catalog:audit": "jiti scripts/audit-catalog.ts",
    "seed": "jiti scripts/seed-catalog.ts",
    "mirror": "jiti scripts/mirror-account.ts",
    "ios:fixtures": "jiti scripts/emit-ios-fixtures.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@neondatabase/serverless": "^1.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/server": "^14.0.1",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "nuxt": "4.6.4",
    "satori": "0.63.2",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@hugeicons/vue": "^1.0.7",
    "@nuxt/test-utils": "^4.0.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/test-utils": "^2.4.11",
    "ajv": "^8.20.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
