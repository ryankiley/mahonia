# Copy to .env and fill in. All optional for local dev — with none set, the app
# runs fully locally (PGlite database + in-memory rate limiting).

# The origin this deployment speaks as — what a sign-in link points at and what a
# passkey is bound to. Leave UNSET on mahonia.app and on Vercel previews: previews
# and local dev derive it from the request (so they mail themselves working links
# with no configuration) and production falls back to the canonical origin pinned
# in shared/site.ts. Set it if you host this anywhere else; a Host header is never
# trusted for it. See server/utils/origin.ts.
MAHONIA_ORIGIN=

# Postgres. Set this for production (Neon). When unset, the app uses a local
# PGlite database instead (see PGLITE_DIR).
DATABASE_URL=

# Pins a Vercel PREVIEW deployment to its own database, winning over DATABASE_URL
# when VERCEL_ENV=preview. Normally unset — Neon's preview-branch integration
# already sets a per-branch DATABASE_URL; this is the in-code safety net.
PREVIEW_DATABASE_URL=

# Where the local PGlite database lives (dev only; ignored when DATABASE_URL is set).
PGLITE_DIR=.data/pglite

# Sending sign-in links (Resend). Unset in development: the link is printed to the
# server console instead, so a fresh checkout signs in with no environment
# variables at all. Unset in PRODUCTION is a real misconfiguration — /api/auth/request
# answers 503 rather than promising an email that was never going to be sent.
RESEND_API_KEY=
# The From header on those messages. Must be a domain verified with Resend;
# production throws without it rather than sending from the wrong address.
AUTH_EMAIL_FROM=

# Upstash Redis REST — the shared per-IP rate-limit store in production.
# When unset, rate limiting falls back to an in-memory store (fine for dev).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Token gating the admin-only moderation endpoints (catalog revert, list restore).
# Requests without a matching x-admin-token header get a 404. Leave unset to
# disable those routes entirely.
GEAR_ADMIN_TOKEN=

# Secret for the nightly community-intake cron (/api/cron/corroborate-catalog).
# Vercel auto-sends it as `Authorization: Bearer $CRON_SECRET` to cron routes.
CRON_SECRET=

# Min distinct lists that must type an item before it's promoted to the catalog
# (community intake). Defaults to 3.
CATALOG_MIN_DISTINCT_LISTS=

# Housekeeping windows for the nightly reap/purge cron, in days. All optional —
# the defaults in listRepo.ts / vaultRepo.ts are what /legal quotes to users
# (30/90 for lists, 180/90 for gear), so changing one here makes that page wrong.
LIST_REAP_STALE_DAYS=
LIST_PURGE_GRACE_DAYS=
VAULT_REAP_STALE_DAYS=
VAULT_PURGE_GRACE_DAYS=

# "Send feedback" files a GitHub issue. Use a FINE-GRAINED token scoped to this one
# repository with Issues: write and nothing else — it is the only permission the
# endpoint needs, and the endpoint is reachable by anyone.
# Unset in development: the message is printed to the server console instead, so a
# fresh checkout runs with no environment variables (same rule as RESEND_API_KEY).
# Unset in PRODUCTION is a real misconfiguration and the endpoint fails loudly,
# rather than accepting feedback that goes nowhere.
GITHUB_FEEDBACK_TOKEN=
# owner/repo — where the issues are filed.
GITHUB_FEEDBACK_REPO=
