# Nuxt / build
.nuxt
.output
.data
dist

# the changelog archive + content/changelog.d/*.json folded into one file, rebuilt
# by every pre-hook. Generated, so it is NOT checked in — a committed copy would
# put every PR back to editing one shared file, which is the conflict the
# fragment split removes. See shared/changelog.ts.
content/changelog.generated.json

# deps
node_modules

# local pinned toolchain (Node 24.15.0) — not committed
.tooling

# env / secrets
.env
.env.*
!.env.example

# misc
.DS_Store
*.log
.vercel
